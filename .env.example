# ── Application ────────────────────────────────────────────────
APP_NAME=Business OS

# Canonical public URLs (no trailing slash)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Database (SQLite via better-sqlite3) ───────────────────────
# Keep this a SQLite file URL. Postgres URLs are not supported by this app.
DATABASE_URL=file:./dev.db

# ── Email — SMTP (preferred for production) ────────────────────
# Gmail example: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USER=you@gmail.com,
# EMAIL_PASS=<Gmail App Password>, EMAIL_SECURE=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
# IMPORTANT: For Gmail, EMAIL_FROM must equal EMAIL_USER (Gmail rejects other senders).
# Leave blank to fall back to EMAIL_USER automatically.
EMAIL_FROM=
EMAIL_SECURE=

# ── Email — Resend (alternative to SMTP) ───────────────────────
RESEND_API_KEY=
RESEND_FROM=Business OS <onboarding@resend.dev>

# ── Lead Copilot — local LLM (Ollama) ──────────────────────────
# The Lead Copilot streams from a local Ollama server. Leave unset to
# use the defaults below; the UI shows an offline state when unreachable.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ── Google OAuth ───────────────────────────────────────────────
# Register the redirect URI: <AUTH_URL>/api/auth/callback/google
# in the Google Cloud console (Authorized redirect URIs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

# ── Session / token lifetimes (hours) ───────────────────────────
# EMAIL_VERIFICATION_EXPIRES_IN=24
# PASSWORD_RESET_EXPIRES_IN=1
